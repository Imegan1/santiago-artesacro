<?xml version="1.0" encoding="UTF-8"?>
<!--
  Descriptor de despliegue de la aplicación Santiago Artesacro.
  Los servlets se registran con anotaciones @WebServlet en cada clase,
  por eso aquí solo se configura lo general.
-->
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         id="WebApp_ID" version="4.0">

  <display-name>santiago-artesacro</display-name>

  <!-- Página que se abre al entrar a la raíz del sitio -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Sesión: 30 minutos de inactividad y cookie no accesible desde JavaScript -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>
</web-app>
